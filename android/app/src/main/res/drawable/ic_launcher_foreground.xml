<?xml version="1.0" encoding="utf-8"?>
<!-- 图标取自站点的内联 favicon（圆角深底 + 紫 A + 青色点）。
     全部用矢量，避免往仓库里塞进被 .gitignore 挡住的 PNG。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 字母 A：外轮廓 + evenOdd 内三角（洞的下沿与横梁上沿之间就是那道横梁） -->
    <path
        android:fillColor="#8B5CF6"
        android:fillType="evenOdd"
        android:pathData="M54,28 L72,78 L62.6,78 L58.4,67 L49.6,67 L45.4,78 L36,78 Z M54,46 L49.2,59.5 L58.8,59.5 Z" />

    <!-- favicon 右上角那个青色点 -->
    <path
        android:fillColor="#22D3EE"
        android:pathData="M64,36 A6,6 0 1,0 76,36 A6,6 0 1,0 64,36 Z" />
</vector>
